{
  "name": "still-and-form",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A storefront debugging challenge for a home goods shop",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js client",
    "start:server": "node server/src/index.js",
    "build": "vite build --config client/vite.config.js client",
    "test": "vitest run --reporter=verbose",
    "test:backend": "vitest run server/tests --reporter=verbose",
    "test:frontend": "vitest run client/src --reporter=verbose",
    "test:business": "vitest run server/tests/business.test.js --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "preview": "vite preview --config client/vite.config.js client"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "axios": "^1.8.4",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "supertest": "^7.1.0",
    "vite": "^6.2.5",
    "vitest": "^3.1.1"
  }
}
